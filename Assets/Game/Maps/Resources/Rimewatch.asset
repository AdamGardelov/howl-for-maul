  Settings:
    Factions:
    - Name: Rime Covenant
      Description: Ice sentinels. Slow the front line and shatter clustered ground
        enemies.
      Designs: 0000000001000000020000000300000004000000
    - Name: Stonebound
      Description: Earth guardians. Durable maze pieces and heavy ground splash;
        dedicate towers to air.
      Designs: 0500000006000000070000000800000009000000
    - Name: Ember Assembly
      Description: Fire constructs. Rapid attacks and expensive bombardment reward
        compact defenses.
      Designs: 0a0000000b0000000c0000000d0000000e000000
    - Name: Volt Vanguard
      Description: Arm-cannon sentries and storm machines. Affordable mazes, precise
        air defense and chaining bolts.
      Designs: 0f00000010000000110000001200000013000000
